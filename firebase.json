{
  "hosting": {
    "public": ".",
    "ignore": [
      "**/.*",
      ".git/**",
      ".firebase/**",
      "server/**",
      "infra/**",
      "docs/**",
      "test/**",
      "**/node_modules/**",
      "README.md",
      "package.json",
      "firebase.json"
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/src/config.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      }
    ]
  }
}
